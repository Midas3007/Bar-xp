rules_version = '2';

// =============================================================================
//  Bar XP — Firestore security rules
//
//  Model:
//    users/{uid}            A user's own document. Owner-only, read and write.
//    public_profiles/{uid}  The leaderboard projection. Readable by any signed-in
//                           athlete; exactly the allow-listed fields, enforced
//                           with hasOnly.
//    friend_cards/{uid}     The richer projection — core stats, volume, streak,
//                           training days — readable only by an accepted friend.
//    workouts/{id}          Private to the owner. Never updated.
//    stats_history/{id}     Private to the owner. Append-only.
//    friend_requests/{id}   `{from}__{to}`. No mutable state: existence IS pending.
//    friendships/{pairId}   `{a}__{b}` sorted. One address per pair, no duplicates.
//    challenges/{id}        Between two friends. Only the invitee may respond.
//      └ scores/{uid}       One document per athlete, named after them.
//
//  The anti-cheat bounds mirror `src/lib/game/validation.ts` so a hand-rolled
//  client cannot write numbers the UI would have rejected.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* --------------------------------------------------------------------- */
    /* Helpers                                                                */
    /* --------------------------------------------------------------------- */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    // A finite number within [min, max].
    function isNumInRange(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function isIntInRange(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    // `YYYY-MM-DD`
    function isDayKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Milliseconds since epoch, loosely bounded to catch garbage.
    function isTimestampMs(value) {
      return value is number && value >= 0 && value <= 4102444800000;
    }

    // The single canonical address for a pair of athletes, so a friendship is
    // checkable from a rule without a query and duplicates are impossible.
    function pairKey(a, b) {
      return a < b ? a + '__' + b : b + '__' + a;
    }

    function friendshipExists(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(pairKey(a, b)));
    }

    function statsAreValid(stats) {
      return stats is map
        && stats.keys().hasOnly(['strength', 'endurance', 'aesthetics', 'discipline'])
        && stats.keys().hasAll(['strength', 'endurance', 'aesthetics', 'discipline'])
        && isNumInRange(stats.strength, 0, 100000)
        && isNumInRange(stats.endurance, 0, 100000)
        && isNumInRange(stats.aesthetics, 0, 100000)
        && isNumInRange(stats.discipline, 0, 100000);
    }

    // Body measurements, metric: bodyweight in kg, every girth in cm. Mirrors
    // MEASUREMENT_BOUNDS in src/lib/game/measurements.ts. These are sanity
    // bounds against typos and against the map being used as free storage —
    // measurements are never scored, so nothing tighter is warranted.
    function measurementValuesAreValid(v) {
      return v is map
        && v.keys().hasOnly(['bodyweight', 'chest', 'back', 'waist', 'biceps', 'thighs', 'calves'])
        && (!('bodyweight' in v) || isNumInRange(v.bodyweight, 20, 400))
        && (!('chest' in v) || isNumInRange(v.chest, 10, 250))
        && (!('back' in v) || isNumInRange(v.back, 10, 250))
        && (!('waist' in v) || isNumInRange(v.waist, 10, 250))
        && (!('biceps' in v) || isNumInRange(v.biceps, 10, 250))
        && (!('thighs' in v) || isNumInRange(v.thighs, 10, 250))
        && (!('calves' in v) || isNumInRange(v.calves, 10, 250));
    }

    /* --------------------------------------------------------------------- */
    /* users                                                                  */
    /* --------------------------------------------------------------------- */

    match /users/{uid} {

      // Strictly owner-only. The user document holds email, body-fat readings,
      // the onboarding assessment, personal bests and per-muscle volume — none
      // of which any other athlete has any business reading. The leaderboard
      // reads `public_profiles` instead.
      //
      // Restricting the *client UI* to safe fields would not have been enough:
      // rules govern the database, and anyone signed in could have queried the
      // raw document directly.
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && userFieldsAreValid()
        && incoming().totalXp == 0
        && isIntInRange(incoming().coins, 0, 1000);

      allow update: if isOwner(uid)
        && userFieldsAreValid()
        // Gross lifetime XP is monotonic — it can never be reduced. A
        // correction does not subtract from it; it adds to `xpVoided`, which is
        // itself append-only and can never exceed what was actually earned. The
        // net figure the game shows is therefore always the difference of two
        // counters that only ever grow, and no write can invent XP.
        && incoming().totalXp >= resource.data.get('totalXp', 0)
        && incoming().get('xpVoided', 0) >= resource.data.get('xpVoided', 0)
        && incoming().get('xpVoided', 0) <= incoming().totalXp;

      // Erasure is the one exception to "profiles are never deleted from the
      // client": an athlete must be able to remove their own account from
      // inside the app. Still owner-only.
      allow delete: if isOwner(uid);

      function userFieldsAreValid() {
        let d = incoming();
        return isShortString(d.displayName, 40)
          && d.displayName.size() >= 1
          && isShortString(d.get('email', ''), 320)
          && isShortString(d.get('photoURL', ''), 2048)
          && d.onboarded is bool
          && isIntInRange(d.level, 1, 100)
          && isNumInRange(d.totalXp, 0, 100000000)
          && isNumInRange(d.get('xpVoided', 0), 0, 100000000)
          && isIntInRange(d.coins, 0, 100000000)
          && statsAreValid(d.stats)
          && isShortString(d.tier, 24)
          && isShortString(d.identity, 24)
          && isNumInRange(d.get('bodyFat', 0), 0, 60)
          // Every clause here uses `get` with a default, so a document written
          // before this slice — which has none of the three keys — still
          // validates. That is load bearing: an update validates the *merged*
          // document, so a legacy profile patched for any other reason must
          // still pass.
          && (d.get('measurements', null) == null || measurementsAreValid(d.measurements))
          && d.get('gymBroMode', true) is bool
          && d.get('unitSystem', 'metric') in ['metric', 'imperial']
          && isIntInRange(d.workoutCount, 0, 1000000)
          && isIntInRange(d.totalReps, 0, 1000000000)
          && streakIsValid(d.streak)
          && inventoryIsValid(d.inventory)
          && (d.get('activeCosmetic', null) == null || isShortString(d.activeCosmetic, 40))
          && d.goals is list && d.goals.size() <= 10
          && d.customExercises is list && d.customExercises.size() <= 20
          // User-authored routines. Mirrors LIMITS.MAX_ROUTINES.
          // `get` with a default is required: every existing user document
          // lacks the field, and an update validates the *merged* document, so
          // a plain `d.routines` would reject every write from an account that
          // has never saved one.
          && d.get('routines', []) is list && d.get('routines', []).size() <= 12
          // Season counters. All three are absent on every live document, so
          // each clause has to tolerate absence — an update validates the
          // *merged* document, not the patch.
          && seasonIsValid(d)
          && (!('seasonHistory' in d) || (d.seasonHistory is list && d.seasonHistory.size() <= 24))
          && (!('recentDays' in d) || (d.recentDays is list && d.recentDays.size() <= 20))
          && d.personalBests is map && d.personalBests.size() <= 200
          // Per-muscle lifetime volume. Bounded so it cannot be used as storage.
          && d.get('muscleVolume', {}) is map
          && d.get('muscleVolume', {}).size() <= 20
          && isTimestampMs(d.get('createdAt', 0))
          && isTimestampMs(d.get('updatedAt', 0));
      }

      function seasonIsValid(d) {
        return !('season' in d) || (
          d.season is map
          && d.season.keys().hasOnly(['id', 'xp', 'sessions', 'startedAt'])
          && isShortString(d.season.id, 16)
          && isNumInRange(d.season.xp, 0, 100000000)
          && isIntInRange(d.season.sessions, 0, 100000)
          && isTimestampMs(d.season.get('startedAt', 0))
        );
      }

      function measurementsAreValid(m) {
        return m is map
          && m.keys().hasOnly(['values', 'recordedAt'])
          && isTimestampMs(m.get('recordedAt', 0))
          && measurementValuesAreValid(m.get('values', {}));
      }

      function streakIsValid(streak) {
        return streak is map
          && isIntInRange(streak.current, 0, 100000)
          && isIntInRange(streak.best, 0, 100000)
          && isIntInRange(streak.get('shieldsUsed', 0), 0, 100000)
          && (streak.get('lastWorkoutDay', null) == null || isDayKey(streak.lastWorkoutDay));
      }

      function inventoryIsValid(inv) {
        return inv is map
          // Shields are capped at the shop's max stack.
          && isIntInRange(inv.streakShields, 0, 5)
          && inv.cosmetics is list && inv.cosmetics.size() <= 20
          && inv.unlocks is list && inv.unlocks.size() <= 20;
      }
    }

    /* --------------------------------------------------------------------- */
    /* public_profiles                                                        */
    /*                                                                        */
    /* The only thing other athletes can see: exactly the fields the           */
    /* leaderboard renders, and nothing else. Mirrored from the user document  */
    /* on every write that changes one of them.                               */
    /* --------------------------------------------------------------------- */

    match /public_profiles/{uid} {

      allow read: if isSignedIn();

      allow create, update: if isOwner(uid) && publicProfileIsValid();

      // Owner-only, so an athlete erasing their account takes their leaderboard
      // row with it.
      allow delete: if isOwner(uid);

      function publicProfileIsValid() {
        let d = incoming();
        // `hasOnly` is the important part — it makes it impossible to smuggle a
        // private field into the public collection later by accident.
        return d.keys().hasOnly([
              'displayName', 'photoURL', 'level', 'totalXp',
              'tier', 'streak', 'activeCosmetic', 'cosmetics', 'updatedAt',
              'searchName', 'seasonId', 'seasonXp', 'lastSeasonId', 'lastSeasonXp',
            ])
          && isShortString(d.displayName, 40)
          && d.displayName.size() >= 1
          && isShortString(d.get('photoURL', ''), 2048)
          && isIntInRange(d.level, 1, 100)
          && isNumInRange(d.totalXp, 0, 100000000)
          && isShortString(d.tier, 24)
          && isIntInRange(d.streak, 0, 100000)
          && (d.get('activeCosmetic', null) == null || isShortString(d.activeCosmetic, 40))
          && d.cosmetics is list && d.cosmetics.size() <= 20
          // Every new field reads through `get` with a default, so a browser
          // still running the previous bundle keeps writing its nine-field row
          // successfully through the rollout.
          && isShortString(d.get('searchName', ''), 40)
          && isShortString(d.get('seasonId', ''), 16)
          && isNumInRange(d.get('seasonXp', 0), 0, 100000000)
          && isShortString(d.get('lastSeasonId', ''), 16)
          && isNumInRange(d.get('lastSeasonXp', 0), 0, 100000000)
          && isTimestampMs(d.get('updatedAt', 0));
      }
    }

    /* --------------------------------------------------------------------- */
    /* workouts                                                               */
    /* --------------------------------------------------------------------- */

    match /workouts/{workoutId} {

      // Sessions are private to the athlete who logged them.
      allow read: if isSignedIn() && isOwner(resource.data.uid);

      allow create: if isOwner(incoming().uid) && workoutIsValid();

      // Logged sessions can never be rewritten. This is what stops a session
      // being edited into more XP than it earned, and it stays absolute — a
      // mistake is corrected by appending a `correction` document that
      // references the original, never by altering it.
      allow update: if false;

      // Deletion exists only so an athlete can erase their own account. It
      // cannot inflate anything: XP is monotonic and `xpVoided` only grows, so
      // removing a workout destroys history and nothing else.
      allow delete: if isSignedIn() && isOwner(resource.data.uid);

      function workoutIsValid() {
        let d = incoming();
        return isDayKey(d.day)
          && isTimestampMs(d.createdAt)
          && d.entries is list
          && d.entries.size() >= 1
          && d.entries.size() <= 12
          && isIntInRange(d.xpEarned, 0, 1000000)
          && isIntInRange(d.coinsEarned, 0, 1000000)
          // Mirrors MAX_SESSION_VOLUME in validation.ts.
          && isIntInRange(d.totalVolume, 0, 5000)
          && isIntInRange(d.totalReps, 0, 5000)
          && (d.get('presetId', null) == null || isShortString(d.presetId, 40))
          && d.get('kind', 'session') in ['session', 'correction']
          && correctionIsInert(d);
      }

      // A correction is an audit record, not a session: it names the workout it
      // retracts and is worth nothing on its own. Without this a client could
      // write `kind: 'correction'` on a document that also granted XP.
      function correctionIsInert(d) {
        return d.get('kind', 'session') != 'correction' || (
          isShortString(d.get('correctsId', ''), 64)
          && d.get('correctsId', '').size() > 0
          && d.xpEarned == 0
          && d.coinsEarned == 0
          && d.totalVolume == 0
          && d.totalReps == 0
        );
      }
    }

    /* --------------------------------------------------------------------- */
    /* stats_history                                                          */
    /* --------------------------------------------------------------------- */

    match /stats_history/{snapshotId} {

      allow read: if isSignedIn() && isOwner(resource.data.uid);

      allow create: if isOwner(incoming().uid) && snapshotIsValid();

      // Append-only in normal operation; deletable only as part of erasing the
      // account that owns it.
      allow update: if false;
      allow delete: if isSignedIn() && isOwner(resource.data.uid);

      function snapshotIsValid() {
        let d = incoming();
        return isDayKey(d.day)
          && isTimestampMs(d.createdAt)
          && statsAreValid(d.stats)
          && isIntInRange(d.level, 1, 100)
          && isNumInRange(d.totalXp, 0, 100000000)
          && isShortString(d.tier, 24)
          && isNumInRange(d.bodyFat, 0, 60)
          && isIntInRange(d.totalReps, 0, 1000000000)
          && isIntInRange(d.streak, 0, 100000)
          && d.source in ['assessment', 'workout', 'measurement', 'correction']
          // `get` with a `{}` default: workout and legacy snapshots never carry
          // the key and must keep passing untouched.
          && measurementValuesAreValid(d.get('measurements', {}));
      }
    }

    /* --------------------------------------------------------------------- */
    /* friend_requests                                                        */
    /*                                                                        */
    /* A request has no mutable state: its existence is "pending". Accepting   */
    /* creates the friendship and deletes the request; declining or            */
    /* cancelling deletes it. With nothing to update, there is nothing to      */
    /* forge.                                                                 */
    /* --------------------------------------------------------------------- */

    match /friend_requests/{requestId} {

      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);

      allow create: if isOwner(incoming().from)
        && incoming().keys().hasOnly(['from', 'to', 'createdAt'])
        && incoming().to is string
        && incoming().to.size() > 0
        && incoming().to != incoming().from
        && requestId == incoming().from + '__' + incoming().to
        && isTimestampMs(incoming().createdAt)
        // You can only request a real athlete...
        && exists(/databases/$(database)/documents/public_profiles/$(incoming().to))
        // ...and only one you are not already friends with.
        && !friendshipExists(incoming().from, incoming().to);

      // Nothing about a request is editable.
      allow update: if false;

      // Either party may make it go away: the sender cancels, the recipient declines.
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    /* --------------------------------------------------------------------- */
    /* friendships                                                            */
    /*                                                                        */
    /* The document id is the canonical sorted pair, so a pair has exactly one */
    /* address and duplicates are impossible. Creating one requires a pending  */
    /* request *from the other member to you* — and since a request can only   */
    /* be created by its sender, you cannot manufacture your own invitation.   */
    /* That one `exists` is the hinge of the whole design.                     */
    /* --------------------------------------------------------------------- */

    match /friendships/{pairId} {

      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['members', 'createdAt'])
        && incoming().members is list
        && incoming().members.size() == 2
        && incoming().members[0] != incoming().members[1]
        && request.auth.uid in incoming().members
        && pairId == pairKey(incoming().members[0], incoming().members[1])
        && isTimestampMs(incoming().createdAt)
        && exists(/databases/$(database)/documents/friend_requests/$(otherOf(incoming().members) + '__' + request.auth.uid));

      allow update: if false;

      allow delete: if isSignedIn() && request.auth.uid in resource.data.members;

      function otherOf(members) {
        return members[0] == request.auth.uid ? members[1] : members[0];
      }
    }

    /* --------------------------------------------------------------------- */
    /* friend_cards                                                           */
    /*                                                                        */
    /* The richer projection — core stats, volume, streak, recent training     */
    /* days — readable only by someone you have an accepted friendship with.   */
    /* `public_profiles` stays exactly as narrow as it was; this is a second,  */
    /* consent-gated door rather than a wider version of the first one.        */
    /* --------------------------------------------------------------------- */

    match /friend_cards/{uid} {

      allow read: if isSignedIn()
        && (request.auth.uid == uid || friendshipExists(uid, request.auth.uid));

      allow create, update: if isOwner(uid) && friendCardIsValid();

      allow delete: if isOwner(uid);

      function friendCardIsValid() {
        let d = incoming();
        return d.keys().hasOnly([
              'displayName', 'photoURL', 'level', 'totalXp', 'tier', 'stats', 'totalReps',
              'workoutCount', 'streak', 'bestStreak', 'seasonId', 'seasonXp',
              'recentDays', 'updatedAt',
            ])
          && isShortString(d.displayName, 40)
          && d.displayName.size() >= 1
          && isShortString(d.get('photoURL', ''), 2048)
          && isIntInRange(d.level, 1, 100)
          && isNumInRange(d.totalXp, 0, 100000000)
          && isShortString(d.tier, 24)
          && statsAreValid(d.stats)
          && isIntInRange(d.totalReps, 0, 1000000000)
          && isIntInRange(d.workoutCount, 0, 1000000)
          && isIntInRange(d.streak, 0, 100000)
          && isIntInRange(d.bestStreak, 0, 100000)
          && isShortString(d.get('seasonId', ''), 16)
          && isNumInRange(d.get('seasonXp', 0), 0, 100000000)
          && d.recentDays is list && d.recentDays.size() <= 20
          && isTimestampMs(d.updatedAt);
      }
    }

    /* --------------------------------------------------------------------- */
    /* challenges                                                             */
    /*                                                                        */
    /* Created by one friend, accepted or declined by the other, and never     */
    /* otherwise edited. There is no stored result: the winner is derived from */
    /* the two score documents, so there is no result to forge and no rule     */
    /* deciding who is allowed to declare victory.                            */
    /* --------------------------------------------------------------------- */

    match /challenges/{challengeId} {

      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if isOwner(incoming().createdBy)
        && incoming().keys().hasOnly([
              'createdBy', 'members', 'templateId', 'title', 'metric', 'window',
              'exerciseId', 'startDay', 'endDay', 'endsAt', 'status',
              'createdAt', 'respondedAt',
            ])
        && incoming().members is list
        && incoming().members.size() == 2
        && incoming().members[0] != incoming().members[1]
        && incoming().createdBy in incoming().members
        // Challenges are between friends only.
        && friendshipExists(incoming().members[0], incoming().members[1])
        && incoming().status == 'pending'
        && incoming().respondedAt == null
        && incoming().metric in ['sessions', 'volume', 'xp', 'exercise_volume']
        && incoming().window in ['week', 'month']
        && (incoming().exerciseId == null || isShortString(incoming().exerciseId, 40))
        && isShortString(incoming().templateId, 40)
        && isShortString(incoming().title, 60)
        && isDayKey(incoming().startDay)
        && isDayKey(incoming().endDay)
        && isTimestampMs(incoming().endsAt)
        && isTimestampMs(incoming().createdAt);

      // Only the invited member may respond, only once, and only to these two keys.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.createdBy
        && resource.data.status == 'pending'
        && incoming().status in ['active', 'declined']
        && isTimestampMs(incoming().respondedAt)
        && incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);

      // Either member may drop a challenge. It is a bet between friends, not a
      // court record — and deleting it is immediately visible to the other side.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.members;

      /* ------------------------------------------------------------------- */
      /* challenges/{id}/scores/{uid}                                         */
      /*                                                                      */
      /* Every athlete's score is a separate document named after them, so the */
      /* rule that stops you writing your opponent's number is just the        */
      /* document id. Scores are self-reported and unverifiable by design;     */
      /* what is enforced is only that they are self-reported by the right     */
      /* self.                                                                */
      /* ------------------------------------------------------------------- */

      match /scores/{scoreUid} {

        allow read: if isSignedIn() && request.auth.uid in challenge().members;

        allow create, update: if isOwner(scoreUid)
          && request.auth.uid in challenge().members
          && incoming().keys().hasOnly(['uid', 'value', 'sessions', 'updatedAt'])
          && incoming().uid == scoreUid
          && isNumInRange(incoming().value, 0, 10000000)
          && isIntInRange(incoming().sessions, 0, 400)
          && isTimestampMs(incoming().updatedAt);

        allow delete: if false;

        function challenge() {
          return get(/databases/$(database)/documents/challenges/$(challengeId)).data;
        }
      }
    }

    /* --------------------------------------------------------------------- */
    /* Default deny                                                           */
    /* --------------------------------------------------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
