# =============================================================================
#  Bar XP — Firebase configuration
#  Copy to `.env` (gitignored) and fill in from your Firebase project settings:
#  Firebase Console -> Project settings -> General -> Your apps -> Web app.
#
#  These values are NOT secrets — a Firebase web config is public by design and
#  ships in the client bundle. Access is controlled by `firestore.rules`, not by
#  hiding these keys.
# =============================================================================

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
